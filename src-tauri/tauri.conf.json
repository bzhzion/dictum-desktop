{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictum",
  "version": "0.0.0",
  "identifier": "org.breizhzion.dictum.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dictum",
        "width": 560,
        "height": 640,
        "minWidth": 460,
        "minHeight": 420,
        "decorations": false,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BREIZHZION",
    "category": "Productivity",
    "shortDescription": "Dictée vocale locale",
    "longDescription": "Dictée vocale entièrement locale : aucun enregistrement ne quitte l'ordinateur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
